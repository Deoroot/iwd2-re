# re-agent secrets — copy this file to ".env" (gitignored) and fill in your key.
# Loaded automatically by re-agent's config loader (stdlib, no python-dotenv).
# A real shell environment variable, if set, takes precedence over this file.

# OpenCode Go subscription key.
# Used by the openai-compat provider against https://opencode.ai/zen/go/v1
# (model deepseek-v4-pro). Never commit the real key.
RE_AGENT_LLM_API_KEY=sk-opencode-REPLACE_ME
